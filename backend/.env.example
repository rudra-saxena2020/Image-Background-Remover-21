DEVICE=auto
QUALITY_DEFAULT=fast
USE_FP16=true
MODEL_WARMUP=true
MAX_UPLOAD_MB=20
MAX_GPU_CONCURRENCY=1
ENABLE_RESULT_CACHE=true
RESULT_CACHE_TTL=3600
CORS_ORIGINS=
BIREFNET_MODEL=ZhengPeng7/BiRefNet
BIREFNET_MODEL_LITE=ZhengPeng7/BiRefNet_lite
# Local-only open-source generation. No paid provider or API key is used.
HIDREAM_REPO=/home/runner/workspace/.local/hidream/HiDream-O1-Image
HIDREAM_MODEL_PATH=/home/runner/workspace/.local/hidream/HiDream-O1-Image-Dev
HIDREAM_PYTHON=/home/runner/workspace/.local/hidream/.venv/bin/python
HIDREAM_MODEL_TYPE=dev
HIDREAM_WIDTH=2048
HIDREAM_HEIGHT=2048
HIDREAM_SHIFT=1
HIDREAM_TIMEOUT_SECONDS=2700
# FLUX.2 Dev: clone the official repository and install the gated native
# weights plus ae.safetensors on a CUDA machine after accepting its license.
FLUX2_REPO=/home/runner/workspace/.local/flux2/flux2
FLUX2_MODEL_PATH=/home/runner/workspace/.local/flux2/models/flux2-dev.safetensors
FLUX2_AE_MODEL_PATH=/home/runner/workspace/.local/flux2/models/ae.safetensors
FLUX2_PYTHON=/home/runner/workspace/.local/hidream/.venv/bin/python
FLUX2_WIDTH=1360
FLUX2_HEIGHT=768
FLUX2_STEPS=50
FLUX2_GUIDANCE=4
FLUX2_TIMEOUT_SECONDS=2700
# FLUX.2 Klein 4B official NVFP4 checkpoint. This requires a compatible
# CUDA/NVFP4 runner; the current CPU-only repl reports it as installed only.
FLUX2_KLEIN_MODEL_PATH=/home/runner/workspace/.local/flux2/models/klein-4b-nvfp4/flux-2-klein-4b-nvfp4.safetensors
FLUX2_KLEIN_PYTHON=/home/runner/workspace/.local/hidream/.venv/bin/python
# Stable Diffusion XL local image-to-image fallback.
SDXL_MODEL_PATH=/home/runner/workspace/.local/sdxl/StableDiffusionXL
SDXL_PYTHON=/home/runner/workspace/.local/hidream/.venv/bin/python
SDXL_WIDTH=512
SDXL_HEIGHT=512
SDXL_STEPS=12
SDXL_CPU_STEPS=2
SDXL_CPU_THREADS=4
SDXL_FAST_WIDTH=256
SDXL_FAST_HEIGHT=256
SDXL_FAST_HUMAN_WIDTH=512
SDXL_FAST_HUMAN_HEIGHT=512
SDXL_FAST_HUMAN_STEPS=8
SDXL_GUIDANCE=7
SDXL_STRENGTH=0.62
SDXL_HUMAN_STRENGTH=0.48
SDXL_FAST_HUMAN_STRENGTH=0.20
SDXL_ALLOW_CPU_GENERATION=true
SDXL_TIMEOUT_SECONDS=1800
# Fail-closed human + product verification. The open-source Faster R-CNN
# checkpoint is downloaded locally by audit_human_product_generation.py.
GENERATION_VERIFICATION_REPORT_PATH=/home/runner/workspace/.local/generation-validation/human-product-report.json
GENERATION_VERIFICATION_TTL_HOURS=168
HUMAN_PRODUCT_VALIDATOR_MODEL_PATH=/home/runner/workspace/.local/generation-validation/fasterrcnn_resnet50_fpn_v2_coco-dd69338a.pth
HUMAN_PRODUCT_PERSON_SCORE=0.72
HUMAN_PRODUCT_BAG_SCORE=0.45
HUMAN_PRODUCT_IDENTITY_SCORE=0.42
# Optional authenticated Google Colab GPU worker. Keep the token in Replit
# Secrets, never in source control. The worker is not considered ready until
# its fresh human-with-exact-product verification passes.
COLAB_WORKER_URL=
COLAB_WORKER_TOKEN=
COLAB_WORKER_TIMEOUT_SECONDS=45
COLAB_WORKER_JOB_TIMEOUT_SECONDS=1800
COLAB_WORKER_POLL_SECONDS=3
# Paid FLUX.2 Pro uses the attached Replit fal.ai connector; do not add a
# fal.ai API key to this project. The default follows connector availability.
FAL_FLUX2_PRO_ENABLED=true
FAL_FLUX2_PRO_CONNECTOR_NAME=falai
FAL_FLUX2_PRO_REQUEST_TIMEOUT_SECONDS=45
FAL_FLUX2_PRO_JOB_TIMEOUT_SECONDS=900
FAL_FLUX2_PRO_POLL_SECONDS=2
FAL_FLUX2_PRO_MAX_RESULT_BYTES=33554432
